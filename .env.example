# ---------------------------------------------------------------------------
# Neon Postgres. Copy the *pooled* connection string from the Neon dashboard
# (it has "-pooler" in the host). Vercel's Neon integration sets this for you.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Signs the admin / participant session cookies. Must be a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs everybody out.
# ---------------------------------------------------------------------------
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ---------------------------------------------------------------------------
# Local development only — leave this unset on Vercel.
# `npm run dev:local` sets it for you, to point the database driver at the
# Postgres-over-HTTP endpoint it runs on your machine instead of Neon's.
# ---------------------------------------------------------------------------
# DATABASE_HTTP_ENDPOINT="https://127.0.0.1:5442/sql"

# ---------------------------------------------------------------------------
# Only read by `npm run db:setup`, to create the very first owner account.
# Delete them from the environment once you have logged in and changed the
# password from inside the admin panel.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@garbhagudi.com"
SEED_ADMIN_PASSWORD="ChangeThisNow!2026"
SEED_ADMIN_NAME="GarbhaGudi Admin"
