{
  "name": "garbhagudi-quiz-platform",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:setup": "node scripts/setup-db.mjs",
    "db:reset": "node scripts/setup-db.mjs --drop",
    "verify": "npm run verify:sql && npm run verify:upgrade && npm run verify:logic && npm run verify:render",
    "verify:sql": "node scripts/verify-sql.mjs",
    "verify:upgrade": "node scripts/verify-upgrade.mjs",
    "verify:logic": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/verify-logic.mts",
    "verify:render": "node scripts/verify-render.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "bcryptjs": "^3.0.2",
    "jose": "^6.0.11",
    "next": "^16.3.3",
    "qrcode-generator": "^2.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "xlsx": "^0.18.5",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.1",
    "pg": "^8.23.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2"
  }
}
